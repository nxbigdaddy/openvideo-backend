PORT=3000

# sqlite | mysql
DB_TYPE=sqlite
DB_SQLITE_PATH=data/dev.sqlite

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=root
DB_NAME=openvideo2026

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Optional: OpenAI-compatible text provider (if not set, falls back to mock)
TEXT_PROVIDER_API_BASE_URL=https://api.openai.com/v1
TEXT_PROVIDER_API_KEY=YOUR_SECRET
TEXT_PROVIDER_MODEL=gpt-4.1-mini

# Optional: Content safety placeholder (comma separated). If any item is included in input,
# the task will be marked FAILED without retries.
CONTENT_BLOCKLIST=涉黄,色情,涉暴,暴力,恐怖,政治敏感

# Encryption key for provider API keys (AES-GCM). Any string; key will be hashed to 32 bytes.
ENCRYPTION_KEY=dev-encryption-key-change-me

# JWT secret for auth
JWT_SECRET=dev-jwt-secret-change-me
